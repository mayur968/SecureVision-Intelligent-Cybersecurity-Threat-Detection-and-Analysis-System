# SecureVision — environment variable template
# Copy to .env and fill in real values. Never commit .env to version control.

# Flask secret key — REQUIRED to start in non-debug mode.
# Generate a strong value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Then set it here or export it in your shell before running app.py.
SECRET_KEY=change-me-in-production

# Debug mode — set to 1 for local development, 0 (or omit) for production.
# When DEBUG=0 and SECRET_KEY is still the default value, the app refuses to start.
DEBUG=1

# Google OAuth 2.0 credentials (from Google Cloud Console → APIs & Services → Credentials)
# Leave blank to run in guest-only mode (Google sign-in button will be hidden)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Feature flag: show legacy scan rows (no user_id, no anon_session_id) to all visitors
# Set to false in production to hide pre-auth rows from guests
SHOW_LEGACY_TO_ALL=true
